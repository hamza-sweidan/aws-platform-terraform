# Copy to terraform.tfvars (gitignored) and fill in.
owner              = "your-github-handle"
region             = "eu-central-1"
monthly_budget_usd = 120
budget_alert_email = "you@example.com"

# Read-only plan role for pull requests (.github/workflows/terraform-plan.yml)
# github_repository = "your-github-handle/aws-platform-terraform"

# Immutable IDs in GitHub's OIDC subject:
#   gh api repos/OWNER/NAME --jq '{owner: .owner.id, repository: .id}'
# github_repository_ids = { owner = 123456, repository = 456789 }
